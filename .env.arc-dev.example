# Hosted profile template. For local setup use npm run arc:setup instead.
WEATHERB_DATABASE_TARGET=supabase
# Separate from the legacy .env. Copy to .env.arc-dev and chmod 600 .env.arc-dev.
# Never add legacy private keys, Redis, or QStash credentials to this profile.
# The Arc lifecycle runner explicitly allows a weather key and fresh test signers.
WEATHERB_SUPABASE_PROJECT_REF=replace_with_new_project_ref
# Runtime role through transaction pooler; use actual host from Supabase Connect.
DATABASE_URL=postgresql://weatherb_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Migration owner through session pooler (IPv4 compatible); never passed to Next.
DIRECT_URL=postgresql://weatherb_migrator.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# After fresh deployment, npm run arc:configure writes the chain/address/test signers.
# Set service credentials locally; never commit their real values.
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# TOMORROW_IO_API_KEY=
