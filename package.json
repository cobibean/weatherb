{
  "name": "weatherB",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "npm --workspace=@weatherb/web run dev",
    "lint": "npm run --workspaces --if-present lint",
    "format:check": "prettier --check .",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "test:voting": "tsx scripts/test-voting-flow.ts",
    "build": "npm --workspace=@weatherb/shared run build && npm --workspace=@weatherb/market-bot run build && npm --workspace=@weatherb/web run build && npm --workspace=@weatherb/contracts run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "eslint-config-prettier": "^9.1.0",
    "next": "^16.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
