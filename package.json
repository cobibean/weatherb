{
  "name": "weatherB",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x",
    "npm": "12.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run arc:setup && npm run arc:dev",
    "lint": "eslint apps/web packages/shared scripts/verification scripts/development scripts/check-contract-abi.mjs scripts/setup-foundry.mjs scripts/run-forge.mjs --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "npm --workspace=@weatherb/shared run typecheck && npm --workspace=@weatherb/web run typecheck",
    "test": "npm run test:unit && npm --workspace=@weatherb/contracts run test",
    "test:voting": "tsx scripts/test-voting-flow.ts",
    "build": "npm --workspace=@weatherb/shared run build && node scripts/verification/run.mjs build && npm --workspace=@weatherb/contracts run build",
    "setup:contracts": "git submodule update --init --recursive && node scripts/setup-foundry.mjs",
    "check:abi": "node scripts/check-contract-abi.mjs",
    "test:safety": "node --test scripts/verification/*.test.mjs",
    "test:unit": "npm run test:safety && npm --workspace=@weatherb/shared run test && npm --workspace=@weatherb/web run test",
    "test:db": "node scripts/verification/database.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build && npm run check:abi",
    "check:deferred:bot": "npm --workspace=@weatherb/market-bot run typecheck",
    "arc:migrate": "node scripts/development/run.mjs migrate",
    "arc:seed": "node scripts/development/run.mjs seed",
    "arc:check": "node scripts/development/run.mjs check",
    "arc:dev": "node scripts/development/run.mjs dev",
    "arc:setup": "node scripts/development/setup-local.mjs",
    "arc:stop": "node scripts/development/setup-local.mjs stop",
    "arc:lifecycle": "node scripts/development/run.mjs lifecycle",
    "arc:configure": "node scripts/development/configure-arc.mjs",
    "arc:wallets": "node scripts/development/setup-wallets.mjs",
    "arc:hosted": "node scripts/development/hosted.mjs",
    "arc:worker": "node scripts/development/worker.mjs",
    "arc:hosted-settler": "node scripts/development/setup-hosted-settler.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "next": "16.3.5",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "keccak@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@5.0.10": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  },
  "overrides": {
    "valtio@1.13.2": {
      "use-sync-external-store": "1.7.0"
    },
    "ws@>=8.0.0 <8.21.0": "8.21.3",
    "prisma@7.10.0": {
      "mysql2": "3.24.4"
    },
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2"
  }
}
